{
  "name": "white-room",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "lint": "npm run lint:format && npm run lint:markdown && npm run lint:frontmatter",
    "lint:format": "prettier --check .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:frontmatter": "bin/check-frontmatter.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.14",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.8"
  }
}
